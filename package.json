{
  "name": "qianjiang-sales-project-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "lab:dev": "vite --config integration-lab/vite.config.ts --host 127.0.0.1 --port 3010",
    "lead:fixtures:import": "node scripts/import-company-lead-fixtures.mjs",
    "demo:bootstrap:public": "pwsh -NoProfile -File scripts/bootstrap-public-demo.ps1",
    "build": "vite build --config integration-lab/vite.config.ts && vinext build",
    "lab:build": "vite build --config integration-lab/vite.config.ts",
    "start": "vinext start",
    "test": "pnpm run build && pnpm run lab:build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:g6:acceptance": "node tests/g6-acceptance.e2e.mjs",
    "test:epc:acceptance": "node tests/g6-acceptance.e2e.mjs epc",
    "test:direct-rfq:acceptance": "node tests/g6-acceptance.e2e.mjs direct-rfq",
    "test:overseas-epc:acceptance": "node tests/g6-acceptance.e2e.mjs overseas-epc",
    "test:bid-round:acceptance": "node tests/g6-acceptance.e2e.mjs bid-round",
    "test:lead:acceptance": "node tests/g6-acceptance.e2e.mjs lead",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --config wrangler.jsonc --local --persist-to .wrangler/state",
    "preview:d1": "pnpm run build && wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --port 3000",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-integration-lab --ignore-pattern public/integration-lab --ignore-pattern .next --ignore-pattern .wrangler"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "^4.124.0"
  },
  "type": "module"
}
